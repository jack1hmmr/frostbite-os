#!/usr/bin/env bash
set -euo pipefail

# XDG_RUNTIME_DIR is created by pam_systemd. Resolve the standard path when
# the variable is missing, but never create or repair a runtime directory from
# the unprivileged session launcher.
expected_runtime_dir="/run/user/$(id -u)"
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
  export XDG_RUNTIME_DIR="$expected_runtime_dir"
fi
[[ "$XDG_RUNTIME_DIR" == "$expected_runtime_dir" ]] || {
  echo "XDG_RUNTIME_DIR does not match the logind runtime path: $XDG_RUNTIME_DIR" >&2
  exit 1
}
[[ -d "$XDG_RUNTIME_DIR" ]] || {
  echo "XDG_RUNTIME_DIR does not exist: $XDG_RUNTIME_DIR" >&2
  exit 1
}
[[ "$(stat -Lc '%u:%a' "$XDG_RUNTIME_DIR")" == "$(id -u):700" ]] || {
  echo "XDG_RUNTIME_DIR has unsafe ownership or mode: $XDG_RUNTIME_DIR" >&2
  exit 1
}

# The dedicated GRUB installer entry must be reachable on GPUs that would
# otherwise boot directly into gamescope and Steam. Sway launches Calamares
# automatically for this one live-only mode.
if grep -qw 'frostbite.install=1' /proc/cmdline 2>/dev/null; then
  installer_sway_config="/etc/sway/frostbite-installer.conf"
  [[ -f "$installer_sway_config" && ! -L "$installer_sway_config" ]] || {
    echo "dedicated installer Sway config is missing or unsafe: $installer_sway_config" >&2
    exit 1
  }
  export XDG_CURRENT_DESKTOP=sway
  # Prefer the hardware renderer, but keep the offline installer reachable on
  # 2D-only and recovery GPUs where wlroots would otherwise reject llvmpipe.
  export WLR_RENDERER_ALLOW_SOFTWARE=1
  exec sway --config "$installer_sway_config"
fi

if [[ -r /etc/frostbite/gamescope.conf ]]; then
  # shellcheck disable=SC1091
  . /etc/frostbite/gamescope.conf
fi

GAMESCOPE_WIDTH="${GAMESCOPE_WIDTH:-1280}"
GAMESCOPE_HEIGHT="${GAMESCOPE_HEIGHT:-720}"
GAMESCOPE_REFRESH="${GAMESCOPE_REFRESH:-60}"
GAMESCOPE_EXTRA_ARGS="${GAMESCOPE_EXTRA_ARGS:--f -e}"

if [[ -f /etc/frostbite/potato-mode ]] || grep -qw 'frostbite.potato=1' /proc/cmdline 2>/dev/null; then
  GAMESCOPE_WIDTH=960
  GAMESCOPE_HEIGHT=540
  export MANGOHUD=0
fi

frostbite-steam-setup >/dev/null 2>&1 || true

# Session mode is decided once, at first boot, by frostbite-firstboot
# (see /var/lib/frostbite/session-mode-detect.log for why). We just
# read that decision here instead of re-probing Vulkan on every login.
session_mode="sway"
if [[ -r /etc/frostbite/session-mode ]]; then
  session_mode="$(cat /etc/frostbite/session-mode)"
fi

# -no-cef-sandbox works around a known Steam-on-Linux crash where the
# Chromium Embedded Framework sandbox triggers an assertion failure on
# some systems. See ArchWiki Steam/Troubleshooting.
STEAM_FLAGS="-gamepadui -no-cef-sandbox"

if [[ "$session_mode" == "gamescope" ]] && command -v gamescope >/dev/null 2>&1 && command -v steam >/dev/null 2>&1; then
  # Word splitting is intentional for GAMESCOPE_EXTRA_ARGS and STEAM_FLAGS.
  # shellcheck disable=SC2086
  exec gamescope -W "$GAMESCOPE_WIDTH" -H "$GAMESCOPE_HEIGHT" -r "$GAMESCOPE_REFRESH" $GAMESCOPE_EXTRA_ARGS -- steam $STEAM_FLAGS
fi

export XDG_CURRENT_DESKTOP=sway
exec sway
