[Unit]
Description=Apply Frostbite OS balanced performance profile
ConditionPathExists=!/etc/frostbite/potato-mode
After=multi-user.target frostbite-firstboot.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/frostbite-performance balanced
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
