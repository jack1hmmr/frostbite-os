set $mod Mod4
set $term foot
set $steam frostbite-steam-launch

# Steam always needs X11 compatibility in this fallback session. Starting
# Xwayland eagerly reduces cold-start delay and surfaces failures sooner.
xwayland force

output * bg #0a0a0c solid_color
font pango:Noto Sans 10

default_border pixel 2
client.focused #5b2a86 #0a0a0c #f2f2f2 #5b2a86 #5b2a86
client.unfocused #1a1a20 #0a0a0c #c9c9d1 #1a1a20 #1a1a20

bindsym $mod+Return exec $term
bindsym $mod+d exec $steam
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m "Exit Frostbite desktop?" -b "Exit" "swaymsg exit"

# Load Arch's Sway session integration, including the environment update for
# D-Bus/systemd user services. Frostbite's custom config otherwise bypasses it.
include /etc/sway/config.d/*

# This ordinary live and installed session remains the Steam-first desktop.
exec $steam
